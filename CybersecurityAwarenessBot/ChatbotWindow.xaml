<Window x:Class="CybersecurityAwarenessBot.ChatbotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CybersecurityAwarenessBot"
        mc:Ignorable="d"
        Title="Cybersecurity Awareness Bot" Height="600" Width="800"
        WindowStartupLocation="CenterScreen">

    <Window.Background>
        <SolidColorBrush Color="#333333"/>
    </Window.Background>

    <Window.Resources>
        <Style x:Key="ChatBubbleUser" TargetType="Border">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="CornerRadius" Value="15,15,5,15"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="50,5,10,5"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="ChatBubbleBot" TargetType="Border">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="CornerRadius" Value="15,15,15,5"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="10,5,50,5"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="ChatText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="20">
            <Border.Background>
                <SolidColorBrush Color="White" Opacity="0.1"/>
            </Border.Background>
            <TextBlock Text="💬 Chat with your Cybersecurity Awareness Bot" 
                      FontSize="24" FontWeight="Bold" 
                      Foreground="White" HorizontalAlignment="Center"/>
        </Border>

        <!-- Chat Area -->
        <ScrollViewer Grid.Row="1" x:Name="ChatScrollViewer" 
                     VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Background>
                <SolidColorBrush Color="White" Opacity="0.05"/>
            </ScrollViewer.Background>
            <StackPanel x:Name="ChatPanel" Margin="10"/>
        </ScrollViewer>

        <!-- Input Area -->
        <Border Grid.Row="2" Padding="10">
            <Border.Background>
                <SolidColorBrush Color="White" Opacity="0.1"/>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="MessageTextBox" Grid.Column="0"
                        Padding="10" FontSize="14" 
                        Background="White" BorderThickness="0"
                        VerticalContentAlignment="Center"
                        KeyDown="MessageTextBox_KeyDown"/>
                <Button Grid.Column="1" Content="Send" 
                       Width="80" Height="35" Margin="10,0,0,0"
                       Background="#4CAF50" Foreground="White"
                       BorderThickness="0" FontWeight="Bold"
                       Click="SendMessage_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>