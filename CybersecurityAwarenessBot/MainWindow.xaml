<Window x:Class="CybersecurityAwarenessBot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CybersecurityAwarenessBot"
        mc:Ignorable="d"
        Title="Cybersecurity Awareness Bot" Height="600" Width="800"
        WindowStartupLocation="CenterScreen">

    <Window.Background>
        <SolidColorBrush Color="#2196F3"/>
    </Window.Background>

    <Window.Resources>
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1565C0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="TitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="36"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,20,0,10"/>
        </Style>

        <Style x:Key="SubtitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,30"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="20">
            <TextBlock Text="🛡️ Cybersecurity Awareness Bot 🛡️" Style="{StaticResource TitleStyle}"/>
            <TextBlock Text="I'm here to help you stay safe online" Style="{StaticResource SubtitleStyle}"/>
        </StackPanel>

        <!-- Welcome Message -->
        <Border Grid.Row="1" CornerRadius="15" Margin="50,0" Padding="20">
            <Border.Background>
                <SolidColorBrush Color="White" Opacity="0.1"/>
            </Border.Background>
            <StackPanel>
                <TextBlock x:Name="WelcomeTextBlock" 
                          Text="Welcome! Please enter your name to get started:"
                          FontSize="16" Foreground="White" 
                          HorizontalAlignment="Center" Margin="0,0,0,15"/>

                <StackPanel x:Name="NameInputPanel" Orientation="Horizontal" 
                           HorizontalAlignment="Center">
                    <TextBox x:Name="NameTextBox" Width="200" Height="35" 
                            FontSize="14" Padding="10,5" Margin="0,0,10,0"
                            Background="White" BorderThickness="0"/>
                    <Button Content="Enter" Click="EnterName_Click" 
                           Style="{StaticResource ButtonStyle}" 
                           Width="80" Height="40" Margin="0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Main Navigation Buttons -->
        <UniformGrid Grid.Row="2" Rows="2" Columns="2" 
                     x:Name="NavigationGrid" Visibility="Collapsed"
                     Margin="50">

            <Button Content="💬 Chat Bot" 
                    Click="OpenChatbot_Click"
                    Style="{StaticResource ButtonStyle}"/>

            <Button Content="📋 Task Manager" 
                    Click="OpenTaskManager_Click"
                    Style="{StaticResource ButtonStyle}"/>

            <Button Content="🎯 Quiz Game" 
                    Click="OpenQuizGame_Click"
                    Style="{StaticResource ButtonStyle}"/>

            <Button Content="📊 Activity Log" 
                    Click="OpenActivityLog_Click"
                    Style="{StaticResource ButtonStyle}"/>
        </UniformGrid>

        <!-- Footer -->
        <TextBlock Grid.Row="3" 
                  Text="Stay safe online! 🔒"
                  FontSize="14" Foreground="White" 
                  HorizontalAlignment="Center" 
                  Margin="0,0,0,20"/>
    </Grid>
</Window>