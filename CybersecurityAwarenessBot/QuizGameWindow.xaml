<Window x:Class="CybersecurityAwarenessBot.QuizGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CybersecurityAwarenessBot"
        mc:Ignorable="d"
        Title="Cybersecurity Quiz Game" Height="600" Width="800"
        WindowStartupLocation="CenterScreen">

    <Window.Background>
        <SolidColorBrush Color="#4CAF50"/>
    </Window.Background>

    <Window.Resources>
        <Style x:Key="QuestionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>

        <Style x:Key="AnswerButtonStyle" TargetType="RadioButton">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#f44336"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="20">
            <Border.Background>
                <SolidColorBrush Color="White" Opacity="0.1"/>
            </Border.Background>
            <StackPanel>
                <TextBlock Text="🎯 Cybersecurity Quiz Game" 
                          FontSize="24" FontWeight="Bold" 
                          Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock x:Name="ScoreTextBlock" Text="Score: 0/10" 
                          FontSize="16" Foreground="White" 
                          HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Quiz Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="QuizPanel" Margin="40,20">

                <!-- Start Screen -->
                <StackPanel x:Name="StartPanel" Visibility="Visible">
                    <TextBlock Text="Test your cybersecurity knowledge!" 
                              Style="{StaticResource QuestionStyle}" 
                              HorizontalAlignment="Center" FontSize="20"/>
                    <TextBlock Text="This quiz contains 10 questions about cybersecurity." 
                              FontSize="16" Foreground="White" 
                              TextWrapping="Wrap" HorizontalAlignment="Center" 
                              Margin="0,10,0,30"/>
                    <Button Content="🚀 Start Quiz" Click="StartQuiz_Click" 
                           Style="{StaticResource ButtonStyle}" 
                           HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Question Panel -->
                <StackPanel x:Name="QuestionPanel" Visibility="Collapsed">
                    <TextBlock x:Name="QuestionNumberText" 
                              Text="Question 1 of 10" 
                              FontSize="14" Foreground="#B0B0B0" 
                              Margin="0,0,0,10"/>

                    <TextBlock x:Name="QuestionText" 
                              Style="{StaticResource QuestionStyle}"/>

                    <StackPanel x:Name="AnswersPanel">
                        <RadioButton x:Name="AnswerA" GroupName="Answers" 
                                    Style="{StaticResource AnswerButtonStyle}"/>
                        <RadioButton x:Name="AnswerB" GroupName="Answers" 
                                    Style="{StaticResource AnswerButtonStyle}"/>
                        <RadioButton x:Name="AnswerC" GroupName="Answers" 
                                    Style="{StaticResource AnswerButtonStyle}"/>
                        <RadioButton x:Name="AnswerD" GroupName="Answers" 
                                    Style="{StaticResource AnswerButtonStyle}"/>
                    </StackPanel>

                    <TextBlock x:Name="FeedbackText" 
                              FontSize="16" Foreground="#FFD700" 
                              TextWrapping="Wrap" Margin="0,20,0,0" 
                              Visibility="Collapsed"/>
                </StackPanel>

                <!-- Results Panel -->
                <StackPanel x:Name="ResultsPanel" Visibility="Collapsed">
                    <TextBlock x:Name="FinalScoreText" 
                              Style="{StaticResource QuestionStyle}" 
                              HorizontalAlignment="Center" FontSize="24"/>
                    <TextBlock x:Name="ResultMessageText" 
                              FontSize="18" Foreground="#E0E0E0" 
                              TextWrapping="Wrap" HorizontalAlignment="Center" 
                              Margin="0,10,0,30"/>
                    <Button Content="🔄 Restart Quiz" Click="RestartQuiz_Click" 
                           Style="{StaticResource ButtonStyle}" 
                           HorizontalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Navigation Buttons -->
        <Border Grid.Row="2" Padding="20">
            <Border.Background>
                <SolidColorBrush Color="White" Opacity="0.0"/>
            </Border.Background>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="SubmitButton" Content="Submit Answer" 
                       Click="SubmitAnswer_Click" 
                       Style="{StaticResource ButtonStyle}" 
                       Visibility="Collapsed"/>
                <Button x:Name="NextButton" Content="Next Question" 
                       Click="NextQuestion_Click" 
                       Style="{StaticResource ButtonStyle}" 
                       Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>